# Postgres. Migrations run as the database's owner, on DATABASE_URL_UNPOOLED when your host has a direct address (Neon on Vercel sets both), otherwise on DATABASE_URL.
# The app connects with DATABASE_URL, as a role allowed to SET ROLE soldlyne_app: the owner's own, which the migration makes a member of it.
DATABASE_URL=postgresql://soldlyne:soldlyne@localhost:55433/soldlyne
DATABASE_URL_UNPOOLED=

# Better Auth. BETTER_AUTH_URL is this install's public address.
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=  # openssl rand -base64 32

# Who may get an account without an invitation, and start workspaces, comma separated. Empty means nobody.
SOLDLYNE_ADMINS=

# Your company's identity provider (any OpenID Connect server). When set, it is the only way in.
# Redirect address to register with it: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Its name on the sign-in page.
OIDC_NAME=

# Addresses and passwords, unless a provider is set above. Needs the mail below: a mailed link proves each address.
SOLDLYNE_PASSWORD_SIGN_IN=false

# Soldlyne's own mail (confirmation links, forgotten passwords, invitations), through Resend. Never prospecting.
# Without it, passwords stay closed and an invitation shows its link to copy.
RESEND_API_KEY=
# The sender, on a domain verified at Resend, for example: Soldlyne <soldlyne@your-domain.com>
SOLDLYNE_MAIL_FROM=

# Gmail and Calendar sync (read only). Redirect address to register on the Google OAuth client:
# <BETTER_AUTH_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the Google tokens stored in the database.
TOKENS_ENCRYPTION_KEY=  # openssl rand -base64 32

# Bearer token that calls to /api/cron/sync must carry. Vercel Cron sends it by itself.
# With no mailbox connected anywhere, a call stops at a cached answer, without touching the database.
CRON_SECRET=  # openssl rand -base64 32
